/* =========================================================================
   ccmw — Textual CSS (styles.tcss)
   Dark theme: surface background, accent highlights
   ========================================================================= */

/* -------------------------------------------------------------------------
   Screen / Root
   ------------------------------------------------------------------------- */

Screen {
    background: $background;
    layout: vertical;
}

/* -------------------------------------------------------------------------
   Main container — horizontal split: FileBrowser(18%) + FileViewer(42%) + TerminalPanel(1fr)
   ------------------------------------------------------------------------- */

#main-container {
    layout: horizontal;
    width: 100%;
    height: 1fr;
}

/* -------------------------------------------------------------------------
   공통 패널 타이틀
   ------------------------------------------------------------------------- */

.panel-title {
    height: 1;
    background: $boost;
    color: $primary;
    text-style: bold;
    padding: 0 2;
    width: 100%;
}

/* -------------------------------------------------------------------------
   FileBrowser pane — Vertical wrapper (width + border 소유)
   ------------------------------------------------------------------------- */

#file-browser-pane {
    width: 18%;
    height: 100%;
    border: solid $surface-lighten-2;
    background: $surface;
    scrollbar-color: $accent 50%;
}

#file-browser-pane:focus-within {
    border: thick $primary;
}

/* -------------------------------------------------------------------------
   상태바 (현재 경로 + 한/영 표시)
   ------------------------------------------------------------------------- */

#status-bar {
    width: 100%;
    height: 1;
    background: $boost;
}

#current-dir {
    width: 1fr;
    height: 1;
    content-align: left middle;
    padding: 0 1;
    color: $text-muted;
    overflow: hidden hidden;
    text-wrap: nowrap;
}

#git-branch {
    width: auto;
    height: 1;
    content-align: center middle;
    padding: 0 1;
    color: $text-muted;
}

#git-branch.git-dirty {
    color: $warning;
    text-style: bold;
}

#git-branch.git-clean {
    color: $success;
}

#input-lang {
    width: 5;
    height: 1;
    content-align: center middle;
    text-style: bold;
}

#input-lang.lang-ko {
    background: $error;
    color: $text;
}

#input-lang.lang-en {
    background: $primary;
    color: $background;
}

/* -------------------------------------------------------------------------
   FileBrowser widget
   ------------------------------------------------------------------------- */

#file-browser {
    width: 100%;
    height: 1fr;
    background: $surface;
}

FileBrowser {
    background: $surface;
}

FileBrowser > .tree--cursor {
    background: $accent-darken-2;
    color: $text;
}

FileBrowser:focus > .tree--cursor {
    background: $accent;
    color: $text;
}

FileBrowser .tree--highlight {
    background: $surface-lighten-1;
}

/* -------------------------------------------------------------------------
   FileViewer panel — 가로/세로 스크롤 모두 활성화
   ------------------------------------------------------------------------- */

#file-viewer {
    display: none;
    width: 42%;
    height: 100%;
    border: solid $surface-lighten-2;
    background: $surface-darken-1;
    scrollbar-color: $accent 50%;
}

#main-container.viewer-open #file-viewer {
    display: block;
}

#main-container.viewer-open #terminal-panel {
    width: 40%;
}

#file-viewer:focus-within {
    border: thick $primary;
}

FileViewer {
    background: $surface-darken-1;
    overflow-x: auto;
    overflow-y: auto;
}

FileViewer > #viewer-title {
    width: 100%;
    height: 1;
    background: $boost;
    color: $primary;
    padding: 0 2;
    text-style: bold;
}

FileViewer > #viewer-scroll {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    overflow-x: auto;
    overflow-y: auto;
}

FileViewer > #viewer-scroll > #file-content {
    width: auto;
    background: $surface-darken-1;
}

FileViewer.word-wrap-on > #viewer-scroll > #file-content {
    width: 1fr;
}

/* -------------------------------------------------------------------------
   TerminalPanel / MultiTerminalPanel panel
   ------------------------------------------------------------------------- */

#terminal-panel {
    width: 1fr;
    height: 100%;
    border: solid $surface-lighten-2;
    background: $surface-darken-1;
    scrollbar-color: $accent 50%;
}

#terminal-panel:focus-within {
    border: thick $primary;
}

MultiTerminalPanel {
    background: $surface-darken-1;
}

MultiTerminalPanel TabbedContent {
    background: $surface-darken-1;
}

MultiTerminalPanel TabPane {
    padding: 0;
    background: $surface-darken-1;
}

MultiTerminalPanel Tabs {
    background: $boost;
}

MultiTerminalPanel Tab {
    padding: 0 2;
}

MultiTerminalPanel Tab.-active {
    color: $primary;
    text-style: bold;
}

TerminalPanel {
    background: $surface-darken-1;
}

TerminalPanel > #terminal-output {
    width: 1fr;
    height: 1fr;
    background: $surface-darken-1;
    color: $text;
    text-wrap: nowrap;
    overflow: hidden hidden;
}

/* -------------------------------------------------------------------------
   SessionPanel — bottom panel
   ------------------------------------------------------------------------- */

#session-panel {
    width: 100%;
    height: auto;
    max-height: 14;
    border: solid $surface-lighten-2;
    background: $surface;
    layer: base;
}

#session-panel:focus-within {
    border: thick $primary;
}

#session-list-title {
    background: $boost;
    color: $primary;
    text-style: bold;
    padding: 0 2;
    width: 100%;
    height: 1;
}

#session-list-view {
    height: 1fr;
    background: $surface;
    scrollbar-color: $accent 50%;
}

#session-list-view > ListItem {
    height: 1;
    padding: 0 2;
    border-left: thick transparent;
}

#session-list-view > ListItem:hover {
    background: $boost;
}

#session-list-view > ListItem.--highlight {
    background: $boost;
    color: $text;
    text-style: bold;
    border-left: thick $accent;
}

#session-list-view > ListItem.--highlight > Label {
    background: $boost;
    color: $text;
    text-style: bold;
    width: 100%;
}

#session-list-view:focus > ListItem.--highlight {
    background: $accent 30%;
    border-left: thick $primary;
}

#session-list-view:focus > ListItem.--highlight > Label {
    background: $accent 30%;
    color: $text;
    text-style: bold;
    width: 100%;
}

/* -------------------------------------------------------------------------
   GitPanel — bottom panel
   ------------------------------------------------------------------------- */

#git-panel {
    width: 100%;
    height: 1fr;
    border: solid $surface-lighten-2;
    background: $surface;
}

#git-panel:focus-within {
    border: thick $primary;
}

#git-panel-title {
    background: $boost;
    color: $primary;
    text-style: bold;
    padding: 0 2;
    width: 100%;
    height: 1;
}

#git-panel-body {
    width: 100%;
    height: 1fr;
    padding: 1 1 0 1;
}

#git-panel-left {
    width: 36;
    height: 100%;
    border-right: solid $surface-lighten-2;
}

/* -------------------------------------------------------------------------
   ListView 공통 규칙 — git-file-list, branch-list, commit-list
   ------------------------------------------------------------------------- */

#git-file-list,
#branch-list,
#commit-list {
    height: 1fr;
    background: $surface;
    scrollbar-color: $accent 50%;
}

#git-file-list > ListItem,
#branch-list > ListItem,
#commit-list > ListItem {
    padding: 0 1;
    border-left: thick transparent;
    height: 1;
}

#git-file-list > ListItem:hover,
#branch-list > ListItem:hover,
#commit-list > ListItem:hover {
    background: $boost;
}

#git-file-list > ListItem.--highlight,
#branch-list > ListItem.--highlight,
#commit-list > ListItem.--highlight {
    background: $boost;
    border-left: thick $accent;
}

#git-file-list:focus > ListItem.--highlight,
#branch-list:focus > ListItem.--highlight,
#commit-list:focus > ListItem.--highlight {
    background: $accent 30%;
    border-left: thick $primary;
}

/* -------------------------------------------------------------------------
   변경사항 / 브랜치 뷰 전환 컨테이너
   ------------------------------------------------------------------------- */

#changes-view {
    width: 100%;
    height: 1fr;
    layout: vertical;
}

#branches-view {
    width: 100%;
    height: 1fr;
    layout: vertical;
}

/* -------------------------------------------------------------------------
   브랜치 입력 / 버튼
   ------------------------------------------------------------------------- */

#branch-name-input {
    width: 100%;
    height: 3;
    margin: 0;
    background: $surface-darken-1;
    border: tall $surface-lighten-2;
}

#branch-name-input:focus-within {
    border: tall $primary;
}

#git-branch-buttons {
    width: 100%;
    height: 3;
    padding: 0 1;
}

#git-branch-buttons Button {
    margin: 0 0 0 1;
    width: 1fr;
}

#git-branch-buttons Button:first-of-type {
    margin: 0;
}

/* -------------------------------------------------------------------------
   커밋 입력 / 버튼 행
   ------------------------------------------------------------------------- */

#git-commit-msg {
    width: 100%;
    height: 3;
    margin: 0;
    background: $surface-darken-1;
    border: tall $surface-lighten-2;
}

#git-commit-msg:focus-within {
    border: tall $primary;
}

#git-stage-row {
    width: 100%;
    height: 3;
    align: right middle;
    padding: 0 1;
}

#git-stage-row Button {
    margin: 0 0 0 1;
    min-width: 10;
}

#git-remote-row {
    width: 100%;
    height: 3;
    margin: 1 0 0 0;
    padding: 0 1;
    layout: horizontal;
}

#git-remote-row Button {
    width: 1fr;
    margin: 0 0 0 1;
}

#git-remote-row Button:first-of-type {
    margin: 0;
}

#btn-review {
    width: 100%;
    height: 3;
    margin: 1 0 0 0;
}

#btn-git-init {
    width: 100%;
    height: 3;
    margin: 1 0 0 0;
}

/* -------------------------------------------------------------------------
   Diff 패널
   ------------------------------------------------------------------------- */

#git-diff-pane {
    width: 1fr;
    height: 100%;
}

#git-diff-title {
    width: 100%;
    height: 1;
    background: $boost;
    color: $primary;
    padding: 0 2;
    text-style: bold;
}

#git-diff-unified {
    width: 100%;
    height: 1fr;
    background: $surface-darken-1;
    padding: 0 1;
    scrollbar-color: $accent 50%;
}

#git-diff-split {
    width: 100%;
    height: 1fr;
}

#git-diff-old {
    width: 1fr;
    height: 100%;
    background: $surface-darken-1;
    padding: 0 1;
    border-right: solid $surface-lighten-2;
    scrollbar-size: 0 0;
}

#git-diff-new {
    width: 1fr;
    height: 100%;
    background: $surface-darken-1;
    padding: 0 1;
    scrollbar-color: $accent 50%;
}

/* -------------------------------------------------------------------------
   히스토리 뷰
   ------------------------------------------------------------------------- */

#history-view {
    width: 100%;
    height: 1fr;
    layout: vertical;
}

#git-history-buttons {
    width: 100%;
    height: 3;
    padding: 0 1;
}

#git-history-buttons Button {
    margin: 0 0 0 1;
    width: 1fr;
    min-width: 0;
}

#git-history-buttons Button:first-of-type {
    margin: 0;
}

/* -------------------------------------------------------------------------
   Utility
   ------------------------------------------------------------------------- */

.hidden {
    display: none;
}

/* -------------------------------------------------------------------------
   Header / Footer
   ------------------------------------------------------------------------- */

Header {
    background: $boost;
    color: $primary;
    text-style: bold;
    dock: top;
    height: 1;
}

Footer {
    background: $boost;
    color: $text-muted;
    dock: bottom;
    height: 1;
}

Footer > .footer--key {
    color: $primary;
    text-style: bold;
    background: $surface-darken-1;
}

Footer > .footer--description {
    color: $text-muted;
}
